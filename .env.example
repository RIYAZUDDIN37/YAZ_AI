# Copy to .env and fill in real values. Never commit .env.
# Loaded/validated at startup by src/lib/env.ts — the app fails fast with a
# readable error if something required is missing, instead of failing
# mysteriously deep inside a route handler.

# --- Database ------------------------------------------------------------
# Local dev: `docker compose up -d` starts a matching Postgres on this URL.
DATABASE_URL="postgresql://yaz:yaz@localhost:5432/yaz_ai?schema=public"

# --- Auth (Auth.js / NextAuth v5) -----------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
# Required once you run `next start` (production mode) instead of `next
# dev` — Auth.js's dev mode silently trusts localhost, production mode
# doesn't, and rejects sign-in with an opaque "UntrustedHost" error
# without this. Not needed for `next dev`.
AUTH_TRUST_HOST="true"

# --- Redis (rate limiting the public widget endpoint — Phase 16) ---------
REDIS_URL="redis://localhost:6379"

# --- AI provider abstraction (src/services/ai) ----------------------------
# The app never hard-codes a single vendor call site; AI_PROVIDER selects
# which adapter src/services/ai/provider.ts constructs. "mock" is the
# default dev adapter — deterministic, keyword-based "understanding" but
# 100% real tool execution against the database — and needs no key. Set
# to "anthropic" + a real key to get genuine LLM-driven tool calling, or
# to "ollama" for a real local LLM with no key and no per-message cost
# (`docker compose up -d ollama` then `docker exec ollama ollama pull
# llama3.2` once). See docs/AI-ARCHITECTURE.md.
AI_PROVIDER="mock" # "mock" | "anthropic" | "ollama"
ANTHROPIC_API_KEY=""
AI_CHAT_MODEL="claude-opus-5"
AI_EMBEDDING_MODEL="text-embedding-3-small"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# --- Email (real delivery for the NOTIFY_TEAM automation action) --------
# Free at resend.com. Leave RESEND_API_KEY empty and NOTIFY_TEAM still
# works — it just skips the email and keeps the in-app notification.
# With Resend's free/unverified sending address (the default below),
# email only delivers to the address on the Resend account itself —
# verify a real domain there to send to your actual team.
RESEND_API_KEY=""
EMAIL_FROM="YAZ AI <onboarding@resend.dev>"

# --- File storage (S3-compatible abstraction — Phase 9 knowledge uploads) -
STORAGE_PROVIDER="local" # "local" | "s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- App -------------------------------------------------------------------
NODE_ENV="development"
