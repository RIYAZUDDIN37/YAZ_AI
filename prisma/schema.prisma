// YAZ AI — Prisma schema
// See docs/DATABASE.md for the full entity-relationship rationale.
//
// This file currently covers the foundation needed for Phase 1/2
// (auth, multi-tenancy, onboarding): User -> OrganizationMember ->
// Organization -> Business -> AIAgent, plus AuditLog.
// The full domain model (conversations, knowledge, tools, orders,
// quotations, appointments, automations...) is added in Phase 3+
// and tracked in CLAUDE.md's "Next steps".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Role of a user within one specific Organization. Centralized permission
/// checks (see src/server/authorization) key off this — never scatter role
/// checks ad hoc across components.
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

/// The vertical a Business operates in. Drives which industry configuration
/// (src/config/industries) is used to label/shape products vs. services,
/// appointment terminology, etc. The underlying schema stays shared.
enum BusinessIndustry {
  FURNITURE
  RESTAURANT
  SALON
  DENTAL
  ELECTRONICS
}

enum AgentStatus {
  ONLINE
  OFFLINE
}

/// Shared by Product and Service — a plain draft/active/archived
/// lifecycle is enough for both catalogue types; no reason to duplicate it.
enum CatalogueStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// spec section 20. The AI creates/updates leads through the createLead /
/// updateLead tools (Phase 8) — a human can also do it from the CRM.
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  APPOINTMENT
  PROPOSAL
  WON
  LOST
}

/// spec section 11 (Human Handoff), exactly the four states named there.
/// Nothing sets AI_HANDLING yet — Phase 7-8 adds the orchestration engine
/// that actually handles a conversation; until then, every conversation
/// starts (and stays) human-handled because there is no AI to hand off to.
enum ConversationStatus {
  AI_HANDLING
  HUMAN_NEEDED
  HUMAN_HANDLING
  RESOLVED
}

/// Who authored a Message. AI is a real option in the schema now so
/// Phase 7-8 doesn't need a migration to add it — but nothing writes
/// senderType: AI yet, and the UI must never label a message AI-authored
/// unless an actual AgentExecution produced it.
enum MessageSenderType {
  CUSTOMER
  AI
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    OrganizationMember[]
  auditLogEntries AuditLog[]
  customerNotes   CustomerNote[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  sentMessages          Message[]      @relation("SentMessages")
  assignedAppointments  Appointment[]  @relation("AssignedAppointments")

  @@map("users")
}

/// A workspace. One User can eventually belong to multiple Organizations
/// (agency / multi-brand use case); v1 onboarding creates exactly one.
model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  businesses Business[]
  auditLogs AuditLog[]

  @@map("organizations")
}

/// Join table carrying the user's role for that organization. This is the
/// row every authorization check ultimately reads.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(OWNER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// One physical/operational business under an Organization. Everything
/// tenant-owned (agents, customers, products...) hangs off businessId, and
/// every service-layer query must filter by it — see docs/SECURITY.md.
model Business {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  slug           String           @unique
  industry       BusinessIndustry
  timezone       String           @default("Asia/Kolkata")
  currency       String           @default("INR")
  onboardedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents         AIAgent[]
  auditLogs      AuditLog[]
  productCategories ProductCategory[]
  products          Product[]
  inventoryItems    InventoryItem[]
  serviceCategories ServiceCategory[]
  services          Service[]
  customers         Customer[]
  customerTags      CustomerTag[]
  leads             Lead[]
  conversations     Conversation[]
  agentExecutions   AgentExecution[]
  agentRules        AgentRule[]
  agentGoals        AgentGoal[]
  knowledgeDocuments KnowledgeDocument[]
  appointments       Appointment[]

  @@index([organizationId])
  @@map("businesses")
}

// ---------------------------------------------------------------------------
// AI employee (minimal stub — expanded in Phase 7-10 with configuration,
// personality, capabilities, rules, knowledge, tools)
// ---------------------------------------------------------------------------

model AIAgent {
  id         String      @id @default(cuid())
  businessId String
  name       String
  title      String
  status     AgentStatus @default(OFFLINE)
  /// Phase 9-10 "Train your AI employee" — free-text personality knobs.
  /// Deliberately plain string fields rather than a separate
  /// AgentPersonality table: there's exactly one of each per agent, so a
  /// 1:1 join table would just be these same two columns one hop away.
  /// Both feed buildSystemPrompt() in src/services/ai/orchestrator.ts.
  tone               String?
  customInstructions String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions AgentExecution[]
  rules      AgentRule[]
  goals      AgentGoal[]

  @@index([businessId])
  @@map("ai_agents")
}

/// Business-configurable governance (spec section 10, Phase 10). Unlike
/// the one hardcoded rule in buildSystemPrompt() ("escalate instead of
/// guessing"), these are owner-authored and injected into the system
/// prompt in `order`. Still prompt-based enforcement, same honest framing
/// as docs/AI-ARCHITECTURE.md already uses — a real business-configurable
/// content path today, evaluated as a distinct pipeline stage later.
model AgentRule {
  id          String   @id @default(cuid())
  businessId  String
  agentId     String
  instruction String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent       AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([agentId])
  @@map("agent_rules")
}

/// What the AI employee is optimizing for (e.g. "Qualify leads for
/// high-value furniture", "Always offer a showroom visit"), distinct from
/// AgentRule's hard constraints. Same injection mechanism as AgentRule.
model AgentGoal {
  id          String   @id @default(cuid())
  businessId  String
  agentId     String
  description String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent       AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([agentId])
  @@map("agent_goals")
}

/// spec section 9 / Phase 9. No file-storage abstraction exists yet, so a
/// document today is pasted/plain text, not an uploaded file — `content`
/// holds it directly. Real chunking happens synchronously at creation
/// (src/services/knowledge/chunk-text.ts), so `status` goes straight to
/// READY or ERROR; PROCESSING exists for when an async pipeline (real file
/// upload, OCR, etc.) actually lands and needs a transient state.
enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  ERROR
}

model KnowledgeDocument {
  id           String                  @id @default(cuid())
  businessId   String
  title        String
  content      String
  status       KnowledgeDocumentStatus @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([businessId])
  @@map("knowledge_documents")
}

/// Retrieval unit. src/services/knowledge/retrieve.ts scores these by
/// lexical (keyword) overlap against the customer's message — real
/// retrieval, not a stub, but honestly not embeddings-based semantic
/// search yet (no EmbeddingService/API key — see AI-ARCHITECTURE.md). The
/// same "simulated understanding, real data" posture as the mock AI
/// provider.
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  businessId String
  chunkIndex Int
  content    String
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// ---------------------------------------------------------------------------
// Catalogue — Product covers Furniture/Electronics/Restaurant-menu items;
// Service covers Salon/Dental. A business can have either or both — the
// industry config (src/config/industries) only picks which one the UI
// labels as the primary "catalogue", it doesn't gate the schema.
// ---------------------------------------------------------------------------

model ProductCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  slug       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("product_categories")
}

model Product {
  id          String            @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  status      CatalogueStatus   @default(ACTIVE)
  images      String[]          @default([])
  /// Industry-specific attributes that don't earn their own column yet —
  /// e.g. { material, dimensions, color } for furniture, { specs,
  /// warrantyMonths } for electronics. Read by the AI's searchProducts /
  /// getProductDetails tools (Phase 8).
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  inventoryItems InventoryItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

/// Optional. Not every product needs variants (a $200 armchair might just
/// be one SKU); when it does (a table in 3 finishes), each variant gets
/// its own InventoryItem so stock is tracked at the level that's actually
/// sold.
model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  name          String
  sku           String         @unique
  priceOverride Decimal?       @db.Decimal(10, 2)
  attributes    Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?

  @@index([productId])
  @@map("product_variants")
}

/// One row per sellable unit — either a Product with no variants, or one
/// row per ProductVariant. checkInventory (Phase 8) reads this, never a
/// raw count on Product itself, so stock is always sourced from one place.
model InventoryItem {
  id                String          @id @default(cuid())
  businessId        String
  productId         String
  variantId         String?         @unique
  sku               String
  quantityOnHand    Int             @default(0)
  quantityReserved  Int             @default(0)
  updatedAt         DateTime        @updatedAt
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@map("inventory_items")
}

model ServiceCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  slug       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("service_categories")
}

model Service {
  id              String           @id @default(cuid())
  businessId      String
  categoryId      String?
  name            String
  slug            String
  description     String?
  durationMinutes Int
  price           Decimal          @db.Decimal(10, 2)
  status          CatalogueStatus  @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// CRM — Customer, tags, notes, and Lead/LeadActivity (spec sections 19-20).
// ---------------------------------------------------------------------------

model CustomerTag {
  id         String     @id @default(cuid())
  businessId String
  name       String
  color      String?
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers  Customer[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("customer_tags")
}

model Customer {
  id         String         @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  source     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tags       CustomerTag[]
  notes      CustomerNote[]
  leads      Lead[]
  conversations Conversation[]
  appointments  Appointment[]

  @@index([businessId])
  @@index([email])
  @@map("customers")
}

model CustomerNote {
  id           String    @id @default(cuid())
  customerId   String
  authorUserId String?
  body         String
  createdAt    DateTime  @default(now())
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorUser   User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_notes")
}

model Lead {
  id         String         @id @default(cuid())
  businessId String
  customerId String?
  status     LeadStatus     @default(NEW)
  source     String?
  intent     String?
  value      Decimal?       @db.Decimal(10, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  appointments Appointment[]

  @@index([businessId])
  @@index([customerId])
  @@map("leads")
}

/// spec section 12 / Phase 14 (partial — the rest of commerce: quotations,
/// orders, payments, still design-only). Labelled per-industry by
/// IndustryConfig.appointmentLabel ("Showroom Visit" for Furniture,
/// "Reservation" for Restaurant, etc.) — the underlying schema is shared.
/// The AI's createAppointment tool (Phase 8 extension) writes here too,
/// same "source" convention as Lead — "AI conversation" vs. staff-booked.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(cuid())
  businessId       String
  customerId       String?
  leadId           String?
  assignedToUserId String?
  purpose          String
  scheduledAt      DateTime
  durationMinutes  Int               @default(30)
  status           AppointmentStatus @default(SCHEDULED)
  source           String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo       User?             @relation("AssignedAppointments", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([businessId, scheduledAt])
  @@index([customerId])
  @@map("appointments")
}

/// Timeline entries for a lead — status changes, notes, and (Phase 8) AI
/// qualification signals. This is what the Leads UI's activity feed reads.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  body      String?
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// Conversations — spec sections 6, 11, 17. No ConversationParticipant or
// MessageAttachment yet: a single `assignedToUserId` covers "who's
// handling this" until multi-participant tracking is actually needed, and
// attachments wait for the file-storage abstraction (Phase 9).
// ---------------------------------------------------------------------------

model Conversation {
  id             String             @id @default(cuid())
  businessId     String
  customerId     String?
  assignedToUserId String?
  status         ConversationStatus @default(HUMAN_HANDLING)
  /// Phase 9-10's Test Employee simulator (spec section 14) reuses the
  /// real orchestrator instead of a separate mocked chat UI — this flag is
  /// what keeps sandbox conversations out of the real Inbox list and out
  /// of the customer picker (test conversations always have
  /// customerId: null, so tools like createLead show their real "no
  /// customer" constraint honestly rather than writing fake CRM data).
  isTest         Boolean            @default(false)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?              @relation("AssignedConversations", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  agentExecutions AgentExecution[]

  @@index([businessId, lastMessageAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  senderUserId   String?
  body           String
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?             @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  triggeredExecutions AgentExecution[] @relation("ExecutionTrigger")
  repliedExecutions   AgentExecution[] @relation("ExecutionReply")
  @@map("messages")
}

/// One row per agentic turn — spec section 8's whole pipeline, from
/// "understand the message" through "log what happened", condensed into
/// one row plus its child AgentActions. `trace` holds the structured
/// step-by-step record (intent, tools considered, rules checked) that
/// backs both the "AI Activity" feed (spec section 18) and the Test
/// Employee simulator's trace panel (spec section 14) — both read real
/// AgentExecution rows, never a separately-maintained fake log.
enum AgentExecutionStatus {
  SUCCESS
  ESCALATED
  ERROR
}

model AgentExecution {
  id               String               @id @default(cuid())
  businessId       String
  conversationId   String
  agentId          String
  triggerMessageId String
  replyMessageId   String?
  status           AgentExecutionStatus
  /// One-line human-readable summary, e.g. "Searched products, found 2
  /// matches, replied with recommendations."
  summary          String
  /// Structured step log: [{ step: "intent" | "tool_call" | "rule_check" |
  /// "response" | "escalation", ... }] — see docs/AI-ARCHITECTURE.md.
  trace            Json
  errorMessage     String?
  createdAt        DateTime             @default(now())
  completedAt      DateTime?
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent            AIAgent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  triggerMessage   Message              @relation("ExecutionTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  replyMessage     Message?             @relation("ExecutionReply", fields: [replyMessageId], references: [id], onDelete: SetNull)
  actions          AgentAction[]

  @@index([businessId])
  @@index([conversationId])
  @@map("agent_executions")
}

/// One row per tool call the AI actually made within an AgentExecution.
/// The AI never touches the database directly — every effect it has goes
/// through a row here, which is what makes "the AI is never trusted with
/// unrestricted access" (docs/SECURITY.md) an enforced fact, not a promise.
model AgentAction {
  id           String         @id @default(cuid())
  executionId  String
  toolName     String
  input        Json
  output       Json?
  status       String
  errorMessage String?
  createdAt    DateTime       @default(now())
  execution    AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("agent_actions")
}

// ---------------------------------------------------------------------------
// Audit trail — every consequential action (signup, org/business creation,
// role changes, later: agent actions, tool executions) writes here.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  businessId     String?
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([businessId])
  @@index([userId])
  @@map("audit_logs")
}
